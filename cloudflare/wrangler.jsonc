// Cloudflare Workers（前段）の設定。
// 画面（frontend/dist）は Workers の静的配信から直接返し、
// /api/・/admin/・/static/ だけ Worker（src/index.js）が Django（Railway）へ転送する。
// 静的ファイルへのアクセスでは Worker は起動しない（無料枠の1日10万リクエストに数えられない）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabi-shiori",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // React Router のURL（/create, /trip/xxx, /join/xxx など）は index.html を返す。
    "not_found_handling": "single-page-application",
    // ここに挙げたパスだけ、静的ファイルより先に Worker を通す。
    "run_worker_first": ["/api/*", "/admin/*", "/static/*"]
  },
  // AIを呼ぶAPIの回数制限（src/index.js の LIMITED_ROUTES で使う）。period は 10 か 60（秒）のみ。
  // Cloudflare の拠点ごとの概算カウントなので、上限ちょうどで止まるとは限らない。
  "ratelimits": [
    // AIのおすすめ候補（1回あたり Gemini 1回 + Places 最大18回）
    { "name": "SPOT_DEVICE_LIMITER", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } },
    { "name": "SPOT_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // 入力内容の確認（Gemini の整合性チェック 1回）
    { "name": "CHECK_DEVICE_LIMITER", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } },
    { "name": "CHECK_IP_LIMITER", "namespace_id": "1004", "simple": { "limit": 40, "period": 60 } },
    // 行先の候補（Gemini 1回）
    { "name": "DEST_DEVICE_LIMITER", "namespace_id": "1005", "simple": { "limit": 6, "period": 60 } },
    { "name": "DEST_IP_LIMITER", "namespace_id": "1006", "simple": { "limit": 40, "period": 60 } },
    // 宿の候補（Gemini 1回 + Places 最大 泊数×7回）
    { "name": "HOTEL_DEVICE_LIMITER", "namespace_id": "1007", "simple": { "limit": 4, "period": 60 } },
    { "name": "HOTEL_IP_LIMITER", "namespace_id": "1008", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // 転送先の Django。ローカル確認時は .dev.vars で上書きする。
    "BACKEND_ORIGIN": "https://project0911-production.up.railway.app"
  },
  "observability": {
    "enabled": true
  }
}
