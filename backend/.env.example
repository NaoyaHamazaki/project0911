# このファイルを .env という名前でコピーして使ってください（.env はgit管理外です）。
# 何も設定しなければ、住所サジェストは無効（自由入力のみ）のまま安全に動作します。

# 住所サジェスト（予測変換）を有効にする場合
# PLACE_PROVIDER=google
# GOOGLE_MAPS_API_KEY=ここにGoogle Maps Platform（Places API）のAPIキー

# 行先と各場所の整合性チェック（任意機能）を有効にする場合
# Google AI Studio (https://aistudio.google.com/apikey) で取得したキーを設定する。
# 未設定でもアプリは通常通り動作する（チェックが行われないだけ）。
# GEMINI_API_KEY=

# 本番運用時に上書きするもの（ローカル開発では不要）
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# PostgreSQLに切り替える場合（未設定ならSQLiteを使用）
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
